{
  "name": "stacked3",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "tauri dev",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/deploy-guard.mjs && tauri build --target aarch64-apple-darwin && node scripts/deploy-guard.mjs && npm run install:app",
    "install:app": "node scripts/install-macos-app.mjs",
    "version:bump:hook": "node scripts/version-bump-hook.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,svelte,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tiptap/core": "^3.10.4",
    "@tiptap/extension-code-block": "^3.10.4",
    "@tiptap/extension-image": "^3.10.4",
    "@tiptap/extension-link": "^3.10.4",
    "@tiptap/extension-text-style": "^3.23.6",
    "@tiptap/html": "^3.10.4",
    "@tiptap/pm": "^3.10.4",
    "@tiptap/starter-kit": "^3.10.4",
    "@tiptap/suggestion": "^3.10.4",
    "idb": "^8.0.0",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.0",
    "lucide-svelte": "^1.0.1",
    "marked": "^13.0.0",
    "openai": "^4.77.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/cli": "^2.11.2",
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.7",
    "@types/marked": "^6.0.0",
    "@types/turndown": "^5.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.4.8",
    "svelte-eslint-parser": "^1.8.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vite": "npm:rolldown-vite@^7.1.14",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.8"
  }
}
