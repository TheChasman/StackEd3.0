{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StackEd",
  "version": "0.1.36",
  "identifier": "com.thechasman.stacked",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "StackEd",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md"
        ],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/markdown",
        "contentTypes": [
          "public.markdown",
          "net.daringfireball.markdown"
        ]
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
